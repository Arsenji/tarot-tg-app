# Database
DATABASE_URL=postgresql://username:password@localhost:5432/tarot_admin

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# Admin credentials
ADMIN_USERNAME=admin
# Хеш пароля (сгенерировать: cd backend && npm run generate-admin-hash -- yourPassword)
ADMIN_PASSWORD_HASH=your-bcrypt-hash-from-script

# YooKassa webhook (секрет для проверки подписи, настраивается в личном кабинете YooKassa)
YOOKASSA_WEBHOOK_SECRET=your-webhook-secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ADMIN_TELEGRAM_ID=your-telegram-user-id
# Webhook (для режима webhook: TELEGRAM_USE_WEBHOOK=true)
WEBHOOK_URL=https://your-backend.onrender.com/api/telegram/webhook

# Server
PORT=3002
NODE_ENV=development
